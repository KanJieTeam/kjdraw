{
  "name": "kjdraw",
  "version": "1.0.0-rc.3",
  "private": true,
  "description": "Open-source CAD engine and ready-to-use editor for engineering apps and AI agents",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/kjdraw-sdk"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "build:runtime": "node --no-warnings scripts/build-typescript.mjs",
    "build:examples": "node --no-warnings scripts/build-plugin-starter.mjs",
    "build:types": "node scripts/build-declarations.mjs",
    "build:docs": "node scripts/build-docs-site.mjs && node scripts/build-api-docs.mjs",
    "build": "node --no-warnings scripts/build-typescript.mjs && node scripts/build-declarations.mjs && node scripts/build-docs-site.mjs && node scripts/build-api-docs.mjs && node scripts/build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "release:version": "node scripts/set-version.mjs",
    "example": "node examples/agent-command.mjs",
    "test:browser": "playwright test",
    "audit:dxf": "node scripts/audit-dxf-corpus.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.25.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vue": "3.5.42"
  }
}
