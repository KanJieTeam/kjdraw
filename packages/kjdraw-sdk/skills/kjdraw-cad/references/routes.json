{
  "schema": "com.kanjie.kjdraw.agent-skill-routes@1",
  "routes": [
    {
      "id": "inspect",
      "when": "只读查询、定位、计数、测量、解释或验证现有图纸内容。",
      "start": ["cad_read_drawing"],
      "tools": [
        "cad_read_page",
        "cad_query_drawing",
        "cad_query_topology",
        "cad_query_impact",
        "cad_read_layouts",
        "cad_read_selection_sets",
        "cad_measure_distance",
        "cad_check_geometry"
      ],
      "rule": "只读取足以回答问题的最窄证据。局部结果不能证明整张图纸。"
    },
    {
      "id": "create",
      "when": "根据明确需求以及宿主选定的单位或知识创建新的可编辑图纸。",
      "start": [],
      "preferredCompilers": [
        "cad_propose_geology_column",
        "cad_propose_geology_section_example",
        "cad_propose_geology_section",
        "cad_propose_manufacturing_sheet",
        "cad_propose_architecture_plan",
        "cad_propose_site_plan",
        "cad_propose_road_drawing",
        "cad_propose_cartesian_chart"
      ],
      "boundedFallbacks": [
        "cad_propose_drawing_annotated",
        "cad_propose_drawing_pattern",
        "cad_propose_drawing_compact",
        "cad_propose_drawing",
        "cad_propose_lines",
        "cad_propose_circles"
      ],
      "rule": "只调用一次与需求匹配的高层编译器。不得把已支持的工程对象拆成大量重复基础图元调用。"
    },
    {
      "id": "modify",
      "when": "精确修改现有图纸，同时保留无关几何和对象关系。",
      "start": ["cad_read_drawing", "cad_query_drawing"],
      "relationshipChecks": ["cad_query_topology"],
      "eraseImpactCheck": ["cad_query_impact"],
      "tools": [
        "cad_propose_text_edit",
        "cad_propose_move",
        "cad_propose_copy",
        "cad_propose_rotate",
        "cad_propose_scale",
        "cad_propose_offset",
        "cad_propose_stretch",
        "cad_propose_lengthen",
        "cad_propose_polyline_edit",
        "cad_propose_relayer",
        "cad_propose_structural_edit",
        "cad_propose_component_insert",
        "cad_propose_design_bind",
        "cad_propose_design_update",
        "cad_propose_road_revision"
      ],
      "rule": "在当前 revision 解析精确 ID，并使用一个最小匹配提案。关系敏感修改前查询拓扑；仅在删除前查询影响。"
    }
  ]
}
