{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "target": "ES2022",
    "outDir": "dist-types",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
