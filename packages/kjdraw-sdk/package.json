      "default": "./src/browser-project-store.js"
    },
    "./selection": {
      "types": "./types/selection.d.ts",
      "import": "./src/selection.js",
      "default": "./src/selection.js"
    },
    "./snapping": {
      "types": "./types/snapping.d.ts",
      "import": "./src/snapping.js",
      "default": "./src/snapping.js"
    }
  },
  "scripts": {
    "test": "node ../../scripts/test.mjs",
    "quickstart": "node examples/quickstart.mjs"
  },
  "license": "Apache-2.0"
}
